# Configure valores reais como segredos do servidor nas configurações do Site.
# Produção: ps_live_. Testes: ps_test_. Mesmo endereço oficial da API.
PURINCASH_API_KEY=
# Use o webhook secret da CONTA, pois callbackUrl usa o segredo da conta.
PURINCASH_WEBHOOK_SECRET=
# Ative somente depois de revisar ofertas, condições e entrega dos pedidos.
STORE_CHECKOUT_ENABLED=false
# O callback exige Site público; em Site privado a consulta no servidor confirma pagamentos.
PURINCASH_WEBHOOK_ENABLED=false
# ID estável do proprietário autenticado, necessário para gestão de pedidos.
STORE_OWNER_USER_ID=
STORE_DISCORD_URL=
STORE_SUPPORT_EMAIL=

# Firebase Authentication: somente Google, sem acesso a Gmail e sem login pelo ChatGPT.
# Identificadores públicos do app web; não use credenciais de uma conta de serviço.
FIREBASE_GOOGLE_ENABLED=false
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
